{
    "interface_version": 2,
    "languages": {
        "zh_cn": "locales/zh_cn.json",
        "zh_tw": "locales/zh_tw.json",
        "en_us": "locales/en_us.json",
        "ja_jp": "locales/ja_jp.json",
        "ko_kr": "locales/ko_kr.json"
    },
    "name": "OurNotesAuto",
    "label": "$app.label",
    "version": "v0.2.1",
    "description": "$app.description",
    "welcome": "$app.welcome",
    "icon": "docs/ui/icon.png",
    "controller": [
        {
            "name": "MuMu",
            "label": "$controller.MuMu",
            "description": "$controller.MuMu.desc",
            "type": "Adb"
        }
    ],
    "resource": [
        {
            "name": "国际服",
            "label": "$resource.intl",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "./.venv/Scripts/python.exe",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "group": [
        {
            "name": "play",
            "label": "$group.play"
        },
        {
            "name": "daily",
            "label": "$group.daily"
        },
        {
            "name": "tools",
            "label": "$group.tools"
        }
    ],
    "import": [
        "tasks/common.json",
        "tasks/start.json",
        "tasks/play.json",
        "tasks/daily.json",
        "tasks/tools.json"
    ],
    "global_option": [
        "GameLanguage",
        "Touch",
        "HumanGreat",
        "HumanTiming",
        "HumanPosition",
        "WatchCombo",
        "RestartLowFps",
        "DebugLog",
        "CheckUpdate",
        "AutoUpdate",
        "Proxy",
        "NotifyChannel",
        "NotifyTarget",
        "NotifyEvents"
    ]
}
