{
    "task": [
        {
            "name": "重复刷歌",
            "label": "$task.Repeat",
            "entry": "OurNotes_Repeat",
            "group": [
                "play"
            ],
            "description": "$task.Repeat.desc",
            "option": [
                "SongMode",
                "Difficulty",
                "MaxPlays",
                "LbCost",
                "LbRefill"
            ]
        },
        {
            "name": "清体力",
            "label": "$task.ClearLB",
            "entry": "OurNotes_ClearLB",
            "group": [
                "play"
            ],
            "description": "$task.ClearLB.desc",
            "option": [
                "SongMode",
                "Difficulty",
                "ClearLbCost",
                "UseSkip",
                "LbRefill",
                "MaxPlays"
            ],
            "default_check": true
        },
        {
            "name": "挂机",
            "label": "$task.Idle",
            "entry": "OurNotes_Idle",
            "group": [
                "play"
            ],
            "description": "$task.Idle.desc",
            "option": [
                "SongMode",
                "Difficulty",
                "IdleLbCost",
                "UseSkip",
                "LbRefill",
                "StudioClaim",
                "DailyClaim",
                "MaxPlays"
            ]
        },
        {
            "name": "AP补完",
            "label": "$task.AP",
            "entry": "OurNotes_AP",
            "group": [
                "play"
            ],
            "description": "$task.AP.desc",
            "option": [
                "ApExpert",
                "ApHard",
                "ApNormal",
                "ApEasy",
                "ApOrder",
                "ApMaxAttempts",
                "LbCost",
                "LbRefill",
                "MaxPlays"
            ]
        },
        {
            "name": "挑战演出",
            "label": "$task.Challenge",
            "entry": "OurNotes_Challenge",
            "group": [
                "play"
            ],
            "description": "$task.Challenge.desc",
            "option": [
                "ChallengeSongMode",
                "Difficulty",
                "ChallengeCost",
                "MaxPlays"
            ]
        },
        {
            "name": "跟打",
            "label": "$task.Assist",
            "entry": "OurNotes_Assist",
            "group": [
                "play"
            ],
            "description": "$task.Assist.desc"
        }
    ],
    "option": {
        "ChallengeSongMode": {
            "type": "select",
            "label": "$opt.ChallengeSongMode",
            "cases": [
                {
                    "name": "rotate",
                    "label": "$opt.ChallengeSongMode.rotate",
                    "description": "$opt.ChallengeSongMode.rotate.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "challenge_song_mode": "rotate" } } }
                },
                {
                    "name": "ap_first",
                    "label": "$opt.ChallengeSongMode.ap_first",
                    "description": "$opt.ChallengeSongMode.ap_first.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "challenge_song_mode": "ap_first" } } }
                },
                {
                    "name": "current",
                    "label": "$opt.ChallengeSongMode.current",
                    "pipeline_override": { "OurNotesParam": { "attach": { "challenge_song_mode": "current" } } }
                }
            ],
            "default_case": "rotate"
        },
        "ChallengeCost": {
            "type": "select",
            "label": "$opt.ChallengeCost",
            "description": "$opt.ChallengeCost.desc",
            "cases": [
                {
                    "name": "200",
                    "label": "$opt.ChallengeCost.200",
                    "pipeline_override": { "OurNotesParam": { "attach": { "challenge_cost": 200 } } }
                },
                {
                    "name": "400",
                    "label": "$opt.ChallengeCost.400",
                    "pipeline_override": { "OurNotesParam": { "attach": { "challenge_cost": 400 } } }
                },
                {
                    "name": "800",
                    "label": "$opt.ChallengeCost.800",
                    "pipeline_override": { "OurNotesParam": { "attach": { "challenge_cost": 800 } } }
                },
                {
                    "name": "1600",
                    "label": "$opt.ChallengeCost.1600",
                    "pipeline_override": { "OurNotesParam": { "attach": { "challenge_cost": 1600 } } }
                },
                {
                    "name": "keep",
                    "label": "$opt.ChallengeCost.keep",
                    "pipeline_override": { "OurNotesParam": { "attach": { "challenge_cost": "keep" } } }
                }
            ],
            "default_case": "200"
        },
        "LbRefill": {
            "type": "switch",
            "label": "$opt.LbRefill",
            "description": "$opt.LbRefill.desc",
            "cases": [
                {
                    "name": "Yes",
                    "option": ["LbRefillCount"],
                    "pipeline_override": { "OurNotesParam": { "attach": { "lb_refill": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "lb_refill": false } } }
                }
            ],
            "default_case": "No"
        },
        "UseSkip": {
            "type": "switch",
            "label": "$opt.UseSkip",
            "description": "$opt.UseSkip.desc",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": { "OurNotesParam": { "attach": { "use_skip": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "use_skip": false } } }
                }
            ],
            "default_case": "No"
        },
        "LbRefillCount": {
            "type": "input",
            "label": "$opt.LbRefillCount",
            "inputs": [
                {
                    "name": "count",
                    "label": "$opt.LbRefillCount.count",
                    "default": "0",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "$opt.LbRefillCount.count.msg"
                }
            ],
            "pipeline_override": { "OurNotesParam": { "attach": { "lb_refill_count": "{count}" } } }
        },
        "StudioClaim": {
            "type": "switch",
            "label": "$opt.StudioClaim",
            "description": "$opt.StudioClaim.desc",
            "cases": [
                {
                    "name": "Yes",
                    "option": ["StudioClaimHours"],
                    "pipeline_override": { "OurNotesParam": { "attach": { "studio_claim": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "studio_claim": false } } }
                }
            ],
            "default_case": "Yes"
        },
        "StudioClaimHours": {
            "type": "input",
            "label": "$opt.StudioClaimHours",
            "inputs": [
                {
                    "name": "hours",
                    "label": "$opt.StudioClaimHours.hours",
                    "default": "4",
                    "pipeline_type": "int",
                    "verify": "^([1-9]|1[0-2])$",
                    "pattern_msg": "$opt.StudioClaimHours.hours.msg"
                }
            ],
            "pipeline_override": { "OurNotesParam": { "attach": { "studio_claim_hours": "{hours}" } } }
        },
        "DailyClaim": {
            "type": "switch",
            "label": "$opt.DailyClaim",
            "description": "$opt.DailyClaim.desc",
            "cases": [
                {
                    "name": "Yes",
                    "option": ["DailyClaimTime"],
                    "pipeline_override": { "OurNotesParam": { "attach": { "daily_claim": true } } }
                },
                {
                    "name": "No",
                    "pipeline_override": { "OurNotesParam": { "attach": { "daily_claim": false } } }
                }
            ],
            "default_case": "Yes"
        },
        "DailyClaimTime": {
            "type": "input",
            "label": "$opt.DailyClaimTime",
            "inputs": [
                {
                    "name": "time",
                    "label": "$opt.DailyClaimTime.time",
                    "default": "22:30",
                    "pipeline_type": "string",
                    "verify": "^([01]?\\d|2[0-3]):[0-5]\\d$",
                    "pattern_msg": "$opt.DailyClaimTime.time.msg"
                }
            ],
            "pipeline_override": { "OurNotesParam": { "attach": { "daily_claim_time": "{time}" } } }
        },
        "LbCost": {
            "type": "select",
            "label": "$opt.LbCost",
            "description": "$opt.LbCost.desc",
            "cases": [
                {
                    "name": "keep",
                    "label": "$opt.LbCost.keep",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "lb_cost": "keep"
                            }
                        }
                    }
                },
                {
                    "name": "auto",
                    "label": "$opt.LbCost.auto",
                    "description": "$opt.LbCost.auto.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "lb_cost": "auto" } } }
                },
                {
                    "name": "0",
                    "label": "$opt.LbCost.0",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "lb_cost": 0
                            }
                        }
                    }
                },
                {
                    "name": "1",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "lb_cost": 1
                            }
                        }
                    }
                },
                {
                    "name": "2",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "lb_cost": 2
                            }
                        }
                    }
                },
                {
                    "name": "3",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "lb_cost": 3
                            }
                        }
                    }
                },
                {
                    "name": "4",
                    "label": "$opt.LbCost.4",
                    "pipeline_override": { "OurNotesParam": { "attach": { "lb_cost": 4 } } }
                },
                {
                    "name": "5",
                    "label": "$opt.LbCost.5",
                    "pipeline_override": { "OurNotesParam": { "attach": { "lb_cost": 5 } } }
                }
            ],
            "default_case": "keep"
        },
        "ClearLbCost": {
            "type": "select",
            "label": "$opt.ClearLbCost",
            "description": "$opt.ClearLbCost.desc",
            "cases": [
                {
                    "name": "auto",
                    "label": "$opt.LbCost.auto",
                    "description": "$opt.LbCost.auto.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "clear_lb_cost": "auto" } } }
                },
                {
                    "name": "5",
                    "label": "$opt.LbCost.5",
                    "pipeline_override": { "OurNotesParam": { "attach": { "clear_lb_cost": 5 } } }
                },
                {
                    "name": "4",
                    "label": "$opt.LbCost.4",
                    "pipeline_override": { "OurNotesParam": { "attach": { "clear_lb_cost": 4 } } }
                },
                {
                    "name": "3",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "clear_lb_cost": 3
                            }
                        }
                    }
                },
                {
                    "name": "2",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "clear_lb_cost": 2
                            }
                        }
                    }
                },
                {
                    "name": "1",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "clear_lb_cost": 1
                            }
                        }
                    }
                }
            ],
            "default_case": "3"
        },
        "IdleLbCost": {
            "type": "select",
            "label": "$opt.IdleLbCost",
            "description": "$opt.IdleLbCost.desc",
            "cases": [
                {
                    "name": "auto",
                    "label": "$opt.LbCost.auto",
                    "description": "$opt.IdleLbCost.auto.desc",
                    "pipeline_override": { "OurNotesParam": { "attach": { "clear_lb_cost": "auto" } } }
                },
                {
                    "name": "5",
                    "label": "$opt.LbCost.5",
                    "pipeline_override": { "OurNotesParam": { "attach": { "clear_lb_cost": 5 } } }
                },
                {
                    "name": "4",
                    "label": "$opt.LbCost.4",
                    "pipeline_override": { "OurNotesParam": { "attach": { "clear_lb_cost": 4 } } }
                },
                {
                    "name": "3",
                    "pipeline_override": { "OurNotesParam": { "attach": { "clear_lb_cost": 3 } } }
                },
                {
                    "name": "2",
                    "pipeline_override": { "OurNotesParam": { "attach": { "clear_lb_cost": 2 } } }
                },
                {
                    "name": "1",
                    "pipeline_override": { "OurNotesParam": { "attach": { "clear_lb_cost": 1 } } }
                },
                {
                    "name": "0",
                    "label": "$opt.IdleLbCost.0",
                    "pipeline_override": { "OurNotesParam": { "attach": { "clear_lb_cost": 0 } } }
                }
            ],
            "default_case": "3"
        },
        "ApExpert": {
            "type": "switch",
            "label": "$opt.ApExpert",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "ap_expert": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "ap_expert": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "ApHard": {
            "type": "switch",
            "label": "$opt.ApHard",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "ap_hard": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "ap_hard": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "ApNormal": {
            "type": "switch",
            "label": "$opt.ApNormal",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "ap_normal": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "ap_normal": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "ApEasy": {
            "type": "switch",
            "label": "$opt.ApEasy",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "ap_easy": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "ap_easy": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "ApOrder": {
            "type": "select",
            "label": "$opt.ApOrder",
            "cases": [
                {
                    "name": "hard_first",
                    "label": "$opt.ApOrder.hard_first",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "ap_order": "hard_first"
                            }
                        }
                    }
                },
                {
                    "name": "easy_first",
                    "label": "$opt.ApOrder.easy_first",
                    "pipeline_override": {
                        "OurNotesParam": {
                            "attach": {
                                "ap_order": "easy_first"
                            }
                        }
                    }
                }
            ],
            "default_case": "hard_first"
        },
        "ApMaxAttempts": {
            "type": "input",
            "label": "$opt.ApMaxAttempts",
            "inputs": [
                {
                    "name": "count",
                    "label": "$opt.ApMaxAttempts.count",
                    "default": "3",
                    "pipeline_type": "int",
                    "verify": "^[1-9]\\d?$",
                    "pattern_msg": "$opt.ApMaxAttempts.count.msg"
                }
            ],
            "pipeline_override": {
                "OurNotesParam": {
                    "attach": {
                        "ap_max_attempts": "{count}"
                    }
                }
            }
        }
    }
}
